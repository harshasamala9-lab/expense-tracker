# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.
# ---------------------------------------------------------------------------

# Supabase PostgreSQL connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Prefer the "Session pooler" string (port 5432) when deploying to Render,
# because it supports IPv4 on hosts that do not offer outbound IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Port the Express server listens on.
PORT=5000

# Comma-separated list of allowed browser origins (no trailing slash).
# Development example: http://localhost:5173
# Production example:  https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# development | production | test
NODE_ENV=development

# TLS certificate verification for the database connection.
# Keep "true" for Supabase. Set to "false" only if your host cannot verify
# the certificate chain; traffic is still encrypted, but the certificate
# is not validated.
DB_SSL_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------

# Required. At least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# JWT lifetime. Short-lived tokens are safer; 8 hours is convenient for a demo.
JWT_EXPIRES_IN=8h

# Direct Google OAuth 2.0 (used for Google sign-in in addition to Supabase).
# Create a Web OAuth client in Google Cloud Console and register every exact
# redirect URI, for example:
#   http://localhost:5173/login
#   https://expense-tracker-web-alpha-orcin.vercel.app/login
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# Used only by: npm run admin:create
# Never commit the real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_ROLE=admin

# ---------------------------------------------------------------------------
# Python automation service (FastAPI)
# ---------------------------------------------------------------------------

# Base URL of the Python service. Leave blank to disable CSV imports locally.
AUTOMATION_URL=http://localhost:8000

# Shared secret sent by Express as X-Automation-Key. Must match the value in
# automation/.env. Generate with: openssl rand -hex 32
AUTOMATION_KEY=replace-with-a-shared-automation-key
