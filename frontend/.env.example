# ---------------------------------------------------------------------------
# Frontend environment variables (Vite exposes only variables prefixed VITE_)
# Copy this file to frontend/.env when you need to override the defaults.
# ---------------------------------------------------------------------------

# Base URL of the Express API, including the /api suffix.
# In development you can omit this and rely on the Vite proxy (/api -> :5000).
# In production set it to the deployed Render URL, e.g.
# VITE_API_URL=https://expense-tracker-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ISO 4217 currency code used by Intl.NumberFormat.
# Examples: USD, INR, EUR, GBP.
VITE_CURRENCY=USD

# Google OAuth 2.0 client ID used by the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
